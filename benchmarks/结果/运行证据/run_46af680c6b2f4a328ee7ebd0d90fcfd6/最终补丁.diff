     def save(self) -> None:
+        """Persist the index atomically via a temp file + ``os.replace``.
+
+        The payload is first written to a unique temporary file in the same
+        directory and flushed to disk; only after that the temp file is moved
+        over the final path with ``os.replace``. A crash or write error can
+        therefore never leave a truncated or partial index at ``self.path`` —
+        readers keep observing the previous complete index file.
