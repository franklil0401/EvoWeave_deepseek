diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..b42f60f926deb7cc159ca02dee95a41e847a4988 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -72,8 +72,27 @@ class TranscriptStore:
     def count(self) -> int:
         return sum(1 for _ in self.iter_records())
 
+    def delete_by_source(self, source: str) -> int:
+        """Delete all records with the given source, keeping the rest.
+
+        Returns the number of records removed. Records with any other source
+        (e.g. classroom/teacher records) are preserved verbatim.
+        """
+        if not self.path.is_file():
+            return 0
+        rows = list(self.iter_records())
+        kept = [row for row in rows if row.source != source]
+        removed = len(rows) - len(kept)
+        if removed == 0:
+            return 0
+        tmp = self.path.with_name(self.path.name + ".tmp")
+        with tmp.open("w", encoding="utf-8") as file:
+            for row in kept:
+                file.write(json.dumps(row.to_dict(), ensure_ascii=False) + "\n")
+        tmp.replace(self.path)
+        return removed
+
     def clear(self) -> None:
         if self.path.exists():
             self.path.unlink()
-        self.path.touch()
-
+        self.path.touch()
