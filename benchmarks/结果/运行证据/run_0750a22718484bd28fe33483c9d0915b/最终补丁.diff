diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..9814e58f4ab6589e2bbb4fa9b5ed66ae3ad90157 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -77,3 +77,31 @@ class TranscriptStore:
             self.path.unlink()
         self.path.touch()
 
+    def clear_student_questions(self) -> int:
+        """Remove only student-sourced records.
+
+        Classroom (teacher) records are preserved so that the retrieval index
+        built from them stays intact. Returns the number of removed records.
+        """
+        if not self.path.is_file():
+            return 0
+        with self.path.open("r", encoding="utf-8") as file:
+            lines = [line for line in file.read().splitlines() if line.strip()]
+        kept: list[str] = []
+        removed = 0
+        for line in lines:
+            try:
+                source = json.loads(line).get("source")
+            except (ValueError, json.JSONDecodeError):
+                kept.append(line)
+                continue
+            if source == "student":
+                removed += 1
+            else:
+                kept.append(line)
+        if removed:
+            with self.path.open("w", encoding="utf-8") as file:
+                file.write("\n".join(kept))
+                if kept:
+                    file.write("\n")
+        return removed
\ No newline at end of file
