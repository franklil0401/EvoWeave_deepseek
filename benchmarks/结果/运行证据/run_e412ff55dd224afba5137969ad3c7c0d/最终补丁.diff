diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..83c8bf18a1762039ab7cf55594df5d3722d2c2bb 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -72,8 +72,41 @@ class TranscriptStore:
     def count(self) -> int:
         return sum(1 for _ in self.iter_records())
 
+    def clear_source(self, source: str) -> int:
+        """Remove every record whose source matches, keeping all the others.
+
+        Returns the number of removed records. Used to drop the student-question
+        history without touching teacher transcripts.
+        """
+        if not self.path.is_file():
+            return 0
+
+        removed = 0
+        remaining: list[TranscriptRecord] = []
+        with self.path.open("r", encoding="utf-8") as file:
+            for line in file:
+                line = line.strip()
+                if not line:
+                    continue
+                raw = json.loads(line)
+                if str(raw.get("source")) == source:
+                    removed += 1
+                    continue
+                remaining.append(
+                    TranscriptRecord(
+                        id=str(raw["id"]),
+                        source=str(raw["source"]),
+                        text=str(raw["text"]),
+                        created_at=str(raw["created_at"]),
+                    )
+                )
+
+        with self.path.open("w", encoding="utf-8") as file:
+            for record in remaining:
+                file.write(json.dumps(record.to_dict(), ensure_ascii=False) + "\n")
+        return removed
+
     def clear(self) -> None:
         if self.path.exists():
             self.path.unlink()
-        self.path.touch()
-
+        self.path.touch()
