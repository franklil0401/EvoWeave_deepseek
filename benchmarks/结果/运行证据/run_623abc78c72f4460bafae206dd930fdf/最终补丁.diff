diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..b956a1d4405b96ea8aa6707b2dcaaf1f437b7e14 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -77,3 +77,18 @@ class TranscriptStore:
             self.path.unlink()
         self.path.touch()
 
+    def delete_student_questions(self) -> int:
+        """Remove only student-question records, keeping classroom (teacher) records.
+
+        Returns the number of student-question records removed. The retrieval
+        index is unaffected because student questions are not part of it.
+        """
+        if not self.path.is_file():
+            return 0
+        records = list(self.iter_records())
+        kept = [record for record in records if record.source != "student"]
+        removed = len(records) - len(kept)
+        with self.path.open("w", encoding="utf-8") as file:
+            for record in kept:
+                file.write(json.dumps(record.to_dict(), ensure_ascii=False) + "\n")
+        return removed
