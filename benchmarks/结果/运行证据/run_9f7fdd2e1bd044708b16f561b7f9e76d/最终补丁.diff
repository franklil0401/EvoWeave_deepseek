     def save(self) -> None:
+        """Atomically persist the index via a temp file + os.replace.
+
+        The payload is first written to a unique temporary file inside the
+        index directory, flushed and fsynced, then swapped into place with
+        ``os.replace``. A reader either observes the complete old index or the
+        complete new index, and a failed write never corrupts an existing one.
+        """
         payload = {"documents": self.documents}
-        with self.path.open("w", encoding="utf-8") as file:
-            json.dump(payload, file, ensure_ascii=False, indent=2)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd, tmp_path = tempfile.mkstemp(
+            dir=self.path.parent,
+            prefix=self.path.name + ".",
+            suffix=".tmp",
+        )
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as file:
+                json.dump(payload, file, ensure_ascii=False, indent=2)
+                file.flush()
+                os.fsync(file.fileno())
+            os.replace(tmp_path, self.path)
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
 
