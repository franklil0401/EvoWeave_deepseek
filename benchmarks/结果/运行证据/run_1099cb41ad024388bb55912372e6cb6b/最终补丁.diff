     def transcribe_wav(self, wav_path: str | Path) -> TranscriptionResult:
         provider = self.provider
         if provider == "openai":
-            return self._transcribe_openai(Path(wav_path))
+            return self._transcribe_with_retry(
+                "openai", lambda: self._transcribe_openai(Path(wav_path))
+            )
         if provider == "doubao":
-            return self._transcribe_doubao(Path(wav_path))
+            return self._transcribe_with_retry(
+                "doubao", lambda: self._transcribe_doubao(Path(wav_path))
+            )
         if provider == "doubao_streaming":
             raise RuntimeError("豆包流式 ASR 需要直接接收实时 PCM 音频，不能使用 WAV 片段转写。")
         raise RuntimeError(f"不支持的云端转写提供方：{provider}")
 
+    def _transcribe_with_retry(
+        self, provider_name: str, func: Callable[[], TranscriptionResult]
+    ) -> TranscriptionResult:
+        """云端转写在网络/服务异常时自动重试一次，仍失败则回退并返回结构化结果。"""
+        last_exc: Exception | None = None
+        for _ in range(2):  # 首次调用 + 重试一次
+            try:
+                return func()
+            except Exception as exc:  # noqa: BLE001
+                last_exc = exc
+                if not self._is_retryable_error(exc):
+                    break
+        # 重试仍失败：回退并返回结构化结果
+        return TranscriptionResult(
+            text="",
+            provider=provider_name,
+            warning=f"{provider_name} 转写失败：{last_exc}",
+        )
+
+    @staticmethod
+    def _is_retryable_error(exc: Exception) -> bool:
+        """判断是否属于网络/服务异常（应触发自动重试）。"""
+        try:
+            import openai
+
+            if isinstance(
+                exc,
+                (
+                    openai.APIConnectionError,
+                    openai.APITimeoutError,
+                    openai.APIStatusError,
+                ),
+            ):
+                return True
+        except Exception:
+            pass
+        return isinstance(exc, (ConnectionError, TimeoutError, OSError))
+
     def _transcribe_openai(self, wav_path: Path) -> TranscriptionResult:
         if not self.settings.openai_api_key:
             raise RuntimeError("缺少 OPENAI_API_KEY，无法使用 OpenAI 音频转写。")
