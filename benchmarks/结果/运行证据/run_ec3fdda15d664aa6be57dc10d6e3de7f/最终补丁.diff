+    def _transcribe_with_retry(
+        self,
+        transcribe_fn: Callable[[], TranscriptionResult],
+        provider: str,
+    ) -> TranscriptionResult:
+        """云端转写失败时自动重试一次；重试仍失败则回退并返回结构化结果。
+
+        - 配置/依赖缺失（TranscriptionConfigError）属于确定性错误，直接抛出，不重试；
+        - 其余网络/服务异常自动重试一次（共 2 次尝试）；
+        - 重试仍失败时不再抛出，回退返回带 warning 的空 TranscriptionResult。
+        """
+        last_error: Exception | None = None
+        for _ in range(self._TRANSCRIBE_MAX_ATTEMPTS):
+            try:
+                return transcribe_fn()
+            except TranscriptionConfigError:
+                raise
+            except Exception as exc:  # 网络/服务异常等可重试错误
+                last_error = exc
+        return TranscriptionResult(
+            text="",
+            provider=provider,
+            warning=f"云端转写失败（已自动重试一次仍失败）：{last_error}",
+        )
