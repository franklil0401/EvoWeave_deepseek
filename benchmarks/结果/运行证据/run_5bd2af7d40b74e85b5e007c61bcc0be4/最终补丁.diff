+    def _transcribe_with_retry(
+        self,
+        call: Callable[[], TranscriptionResult],
+        provider: str,
+    ) -> TranscriptionResult:
+        """执行云端转写调用；网络或服务异常时自动重试一次。
+
+        两次尝试均失败时回退：返回空文本的结构化结果并在 warning 中说明失败原因，
+        不再向上抛出异常，避免打断录音转写流程。
+        """
+        last_error: Exception | None = None
+        for _ in range(2):
+            try:
+                return call()
+            except Exception as exc:
+                last_error = exc
+        return TranscriptionResult(
+            text="",
+            provider=provider,
+            warning=f"{provider} 云端转写失败（已自动重试一次）：{last_error}",
+        )
+
