+    def _run_with_retry(
+        self,
+        attempt: Callable[[], str],
+        provider: str,
+        display_name: str,
+    ) -> TranscriptionResult:
+        """执行云端转写：网络或服务异常时自动重试一次，仍失败则回退为结构化结果。
+
+        配置缺失、依赖缺失等本地问题在进入本方法前就已抛出，
+        这里只兜底真正发生在云端调用过程中的网络/服务异常。
+        """
+        try:
+            return TranscriptionResult(text=attempt(), provider=provider)
+        except Exception as exc:
+            try:
+                return TranscriptionResult(text=attempt(), provider=provider)
+            except Exception as retry_exc:
+                return TranscriptionResult(
+                    text="",
+                    provider=provider,
+                    warning=f"{display_name}转写失败，已自动重试一次仍失败：{retry_exc}",
+                )
+
