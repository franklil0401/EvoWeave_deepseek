@@ -60,13 +61,37 @@ class AudioTranscriber:
     def transcribe_wav(self, wav_path: str | Path) -> TranscriptionResult:
         provider = self.provider
         if provider == "openai":
-            return self._transcribe_openai(Path(wav_path))
+            return self._transcribe_with_retry("openai", self._transcribe_openai, Path(wav_path))
         if provider == "doubao":
-            return self._transcribe_doubao(Path(wav_path))
+            return self._transcribe_with_retry("doubao", self._transcribe_doubao, Path(wav_path))
         if provider == "doubao_streaming":
             raise RuntimeError("豆包流式 ASR 需要直接接收实时 PCM 音频，不能使用 WAV 片段转写。")
         raise RuntimeError(f"不支持的云端转写提供方：{provider}")
 
+    def _transcribe_with_retry(
+        self,
+        provider: str,
+        transcribe: Callable[[Path], TranscriptionResult],
+        wav_path: Path,
+    ) -> TranscriptionResult:
+        """转写失败自动重试一次；重试仍失败则回退并返回结构化结果。
+
+        网络或服务异常时先自动重试一次；若重试仍失败，则返回带 warning 的
+        空转写结果，而不是向调用方抛出异常，保证调用方能拿到结构化结果。
+        """
+        last_error: Exception | None = None
+        for _ in range(2):  # 首次尝试 + 自动重试一次
+            try:
+                return transcribe(wav_path)
+            except Exception as exc:
+                last_error = exc
+        # 两次尝试均失败，回退为结构化结果
+        return TranscriptionResult(
+            text="",
+            provider=provider,
+            warning=f"{provider} 转写失败（已自动重试一次）：{last_error}",
+        )
+
     def _transcribe_openai(self, wav_path: Path) -> TranscriptionResult:
         if not self.settings.openai_api_key:
             raise RuntimeError("缺少 OPENAI_API_KEY，无法使用 OpenAI 音频转写。")
