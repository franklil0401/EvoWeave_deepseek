diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..5b3104666f3a6167965ee6635fdfd01170f777c9 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -72,8 +72,31 @@ class TranscriptStore:
     def count(self) -> int:
         return sum(1 for _ in self.iter_records())
 
+    def clear_source(self, source: str) -> int:
+        """Remove all records of the given source, returning how many were removed.
+
+        Records of other sources (e.g. teacher transcripts) are kept untouched.
+        """
+        if not self.path.is_file():
+            return 0
+        removed = 0
+        kept: list[str] = []
+        with self.path.open("r", encoding="utf-8") as file:
+            for line in file:
+                line = line.strip()
+                if not line:
+                    continue
+                raw = json.loads(line)
+                if raw.get("source") == source:
+                    removed += 1
+                    continue
+                kept.append(line)
+        with self.path.open("w", encoding="utf-8") as file:
+            for line in kept:
+                file.write(line + "\n")
+        return removed
+
     def clear(self) -> None:
         if self.path.exists():
             self.path.unlink()
-        self.path.touch()
-
+        self.path.touch()
