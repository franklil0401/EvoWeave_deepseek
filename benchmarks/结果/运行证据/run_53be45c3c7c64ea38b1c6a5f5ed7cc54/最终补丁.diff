diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..1fe8932517e3fbb0e1a81b4c6d5da1aba05f39ff 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -77,3 +77,25 @@ class TranscriptStore:
             self.path.unlink()
         self.path.touch()
 
+    def clear_student_questions(self) -> int:
+        """Remove only student-source records; classroom records are preserved.
+
+        Returns the number of student question records that were removed.
+        """
+        kept_lines: list[str] = []
+        removed = 0
+        if self.path.is_file():
+            with self.path.open("r", encoding="utf-8") as file:
+                for line in file:
+                    line = line.strip()
+                    if not line:
+                        continue
+                    raw = json.loads(line)
+                    if raw.get("source") == "student":
+                        removed += 1
+                        continue
+                    kept_lines.append(line)
+        with self.path.open("w", encoding="utf-8") as file:
+            for line in kept_lines:
+                file.write(line + "\n")
+        return removed
