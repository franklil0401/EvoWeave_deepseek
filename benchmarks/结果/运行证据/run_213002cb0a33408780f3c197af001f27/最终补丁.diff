+    def _transcribe_with_retry(
+        self,
+        provider: str,
+        call: Callable[[], TranscriptionResult],
+    ) -> TranscriptionResult:
+        """执行云端转写：网络/服务异常时自动重试一次，仍失败则回退并返回结构化结果。"""
+        last_error: Exception | None = None
+        for _ in range(2):  # 首次调用 + 一次自动重试
+            try:
+                return call()
+            except Exception as exc:
+                last_error = exc
+        return TranscriptionResult(
+            text="",
+            provider=provider,
+            warning=f"云端音频转写失败，已自动重试一次仍失败：{last_error}",
+        )
+
