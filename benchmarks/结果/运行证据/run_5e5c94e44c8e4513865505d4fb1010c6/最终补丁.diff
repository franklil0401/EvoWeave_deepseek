+    def _transcribe_with_retry(
+        self,
+        provider_name: str,
+        wav_path: Path,
+        transcribe_fn: Callable[[Path], TranscriptionResult],
+    ) -> TranscriptionResult:
+        """网络或服务异常时自动重试一次；重试仍失败则回退并返回结构化结果。"""
+        last_error: Exception | None = None
+        for _ in range(2):  # 首次调用 + 自动重试一次
+            try:
+                return transcribe_fn(wav_path)
+            except Exception as exc:  # 网络/服务异常等转写失败
+                last_error = exc
+        return TranscriptionResult(
+            text="",
+            provider=provider_name,
+            warning=f"{provider_name} 转写失败，已自动重试一次仍失败：{last_error}",
+        )
+
     def _transcribe_openai(self, wav_path: Path) -> TranscriptionResult:
