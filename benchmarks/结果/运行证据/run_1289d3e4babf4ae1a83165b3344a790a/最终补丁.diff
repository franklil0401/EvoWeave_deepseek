diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..7a51bd753e9b30122433a0a581980c56a7671af2 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -77,3 +77,28 @@ class TranscriptStore:
             self.path.unlink()
         self.path.touch()
 
+    def clear_student_questions(self) -> int:
+        """Remove all student-question records while keeping classroom records.
+
+        Returns the number of removed student-question records.
+        """
+        if not self.path.is_file():
+            return 0
+
+        kept: list[str] = []
+        removed = 0
+        with self.path.open("r", encoding="utf-8") as file:
+            for line in file:
+                line = line.strip()
+                if not line:
+                    continue
+                raw = json.loads(line)
+                if raw.get("source") == "student":
+                    removed += 1
+                else:
+                    kept.append(line)
+
+        with self.path.open("w", encoding="utf-8") as file:
+            for line in kept:
+                file.write(line + "\n")
+        return removed
\ No newline at end of file
