     def save(self) -> None:
+        """Atomically persist the index to disk.
+
+        The payload is first written to a temporary file in the same directory
+        and then moved over the target path with ``os.replace``. A failure
+        while writing never leaves a partial or corrupt index at ``self.path``;
+        the previously saved index stays intact until the replacement happens.
+        """
