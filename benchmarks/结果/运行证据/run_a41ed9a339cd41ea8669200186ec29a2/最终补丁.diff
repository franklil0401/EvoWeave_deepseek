index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..50238e4efa4513051c1fd2b36b6155aeb495f426 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -72,8 +72,25 @@ class TranscriptStore:
     def count(self) -> int:
         return sum(1 for _ in self.iter_records())
 
+    def clear_student_questions(self) -> int:
+        """Remove only student-question records while keeping teacher records.
+
+        Returns the number of student-question records removed.
+        """
+        removed = 0
+        kept: list[TranscriptRecord] = []
+        for record in self.iter_records():
+            if record.source == "student":
+                removed += 1
+            else:
+                kept.append(record)
+        if removed:
+            with self.path.open("w", encoding="utf-8") as file:
+                for record in kept:
+                    file.write(json.dumps(record.to_dict(), ensure_ascii=False) + "\n")
+        return removed
+
     def clear(self) -> None:
         if self.path.exists():
             self.path.unlink()
-        self.path.touch()
-
+        self.path.touch()
