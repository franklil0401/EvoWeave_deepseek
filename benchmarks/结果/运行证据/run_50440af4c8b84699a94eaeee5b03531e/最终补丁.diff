diff --git a/rag/transcript_store.py b/rag/transcript_store.py
index 81a0997a692a50e9bb5199334e46e8fd00a75d6a..33b0177048740fefeb68f15af420d38478b5b84c 100644
--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -77,3 +77,20 @@ class TranscriptStore:
             self.path.unlink()
         self.path.touch()
 
+    def clear_source(self, source: str) -> int:
+        """Remove all records with the given source, keeping the rest.
+
+        Returns the number of removed records. Records of other sources, the
+        transcript file layout and any external indexes are left untouched.
+        """
+        kept: list[TranscriptRecord] = []
+        removed = 0
+        for record in self.iter_records():
+            if record.source == source:
+                removed += 1
+            else:
+                kept.append(record)
+        with self.path.open("w", encoding="utf-8") as file:
+            for record in kept:
+                file.write(json.dumps(record.to_dict(), ensure_ascii=False) + "\n")
+        return removed
