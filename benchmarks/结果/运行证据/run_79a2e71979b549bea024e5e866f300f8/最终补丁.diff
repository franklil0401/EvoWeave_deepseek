         raise RuntimeError(f"不支持的云端转写提供方：{provider}")
 
+    def _transcribe_with_retry(
+        self,
+        wav_path: Path,
+        provider: str,
+        transcribe: Callable[[Path], TranscriptionResult],
+    ) -> TranscriptionResult:
+        """云端转写异常时自动重试一次；重试仍失败则回退并返回结构化结果。"""
+        last_error: Exception | None = None
+        for attempt in range(1, TRANSCRIBE_RETRY_COUNT + 2):
+            try:
+                return transcribe(wav_path)
+            except Exception as exc:
+                last_error = exc
+                logger.warning(
+                    "云端转写失败（provider=%s，第 %s/%s 次）：%s",
+                    provider,
+                    attempt,
+                    TRANSCRIBE_RETRY_COUNT + 1,
+                    exc,
+                )
+        return TranscriptionResult(
+            text="",
+            provider=provider,
+            warning=f"云端转写失败，已自动重试 {TRANSCRIBE_RETRY_COUNT} 次：{last_error}",
+        )
+
     def _transcribe_openai(self, wav_path: Path) -> TranscriptionResult:
