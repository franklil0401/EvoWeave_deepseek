+    def _build_documents(self, records: list[TranscriptRecord]) -> list[dict[str, Any]]:
+        """Build the index document list without touching the live index."""
+        documents: list[dict[str, Any]] = []
+        for record in records:
+            chunks = chunk_text(
+                record.text,
+                max_chars=self.settings.chunk_max_chars,
+                overlap=self.settings.chunk_overlap,
+            )
+            for index, chunk in enumerate(chunks):
+                clean = (chunk or "").strip()
+                if not clean:
+                    continue
+                documents.append(
+                    {
+                        "text": clean,
+                        "meta": {
+                            "record_id": record.id,
+                            "source": record.source,
+                            "chunk_index": index,
+                            "created_at": record.created_at,
+                        },
+                    }
+                )
+        return documents
+
