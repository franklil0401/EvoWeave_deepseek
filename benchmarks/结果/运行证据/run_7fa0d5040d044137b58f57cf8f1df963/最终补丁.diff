--- a/rag/transcript_store.py
+++ b/rag/transcript_store.py
@@ -77,3 +77,36 @@ class TranscriptStore:
             self.path.unlink()
         self.path.touch()
 
+    def clear_student_questions(self) -> dict[str, int]:
+        """Clear only student question records, keeping classroom records intact.
+
+        Only lines whose ``source`` is ``"student"`` are removed; teacher/system
+        classroom records (and therefore the retrieval index built from them)
+        are preserved. Returns a structured result:
+
+            {"removed": int, "remaining": int}
+
+        where ``removed`` is the number of student questions deleted and
+        ``remaining`` is the number of classroom records kept.
+        """
+        if not self.path.is_file():
+            return {"removed": 0, "remaining": 0}
+
+        kept_lines: list[str] = []
+        removed = 0
+        with self.path.open("r", encoding="utf-8") as file:
+            for line in file:
+                line = line.strip()
+                if not line:
+                    continue
+                raw = json.loads(line)
+                if raw.get("source") == "student":
+                    removed += 1
+                else:
+                    kept_lines.append(line)
+
+        with self.path.open("w", encoding="utf-8") as file:
+            if kept_lines:
+                file.write("\n".join(kept_lines) + "\n")
+
+        return {"removed": removed, "remaining": len(kept_lines)}
