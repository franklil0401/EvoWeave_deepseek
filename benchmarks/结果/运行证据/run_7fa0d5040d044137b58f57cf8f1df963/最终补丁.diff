 from __future__ import annotations
 
+import json
+import os
+import tempfile
 from typing import Any
 
 from app.config import Settings
@@ -73,7 +76,43 @@ class CourseRAGPipeline:
     def recent_records(self, limit: int = 5) -> list[TranscriptRecord]:
         return self.store.recent(limit)
 
+    def clear_conversation(self) -> dict[str, Any]:
+        """Clear only the student question history (conversation area).
+
+        Classroom notes (teacher records) and the retrieval index are left
+        untouched, so existing notes remain searchable after clearing.
+        """
+        kept: list[TranscriptRecord] = []
+        removed = 0
+        for record in self.store.iter_records():
+            if record.source == "student":
+                removed += 1
+            else:
+                kept.append(record)
+
+        # Rewrite the JSONL transcript atomically, keeping only non-student records.
+        fd, tmp_path = tempfile.mkstemp(
+            dir=str(self.store.path.parent),
+            prefix=".transcripts-",
+            suffix=".tmp",
+        )
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as file:
+                for record in kept:
+                    file.write(json.dumps(record.to_dict(), ensure_ascii=False) + "\n")
+            os.replace(tmp_path, self.store.path)
+        finally:
+            if os.path.exists(tmp_path):
+                os.unlink(tmp_path)
+
+        return {
+            "ok": True,
+            "cleared_count": removed,
+            "remaining_count": len(kept),
+            "message": "问答对话已清空，课堂记录与检索索引不受影响",
+        }
+
     def clear_history(self) -> None:
         self.store.clear()
         self.index.clear()
-        self.index.save()
+        self.index.save()
